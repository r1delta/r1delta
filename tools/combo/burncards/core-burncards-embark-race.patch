+function BurnCardWaitForPilot( player )
+{
+	while ( player.IsTitan() )
+	{
+		player.WaitSignal( "OnLeftTitan" )
+		wait 0.5
+	}
+}
+
+function BurnCardModsEqual( a, b )
+{
+	local aLength = a ? a.len() : 0
+	local bLength = b ? b.len() : 0
+	if ( aLength != bLength )
+		return false
+	for ( local i = 0; i < aLength; i++ )
+	{
+		if ( a[i] != b[i] )
+			return false
+	}
+	return true
+}
