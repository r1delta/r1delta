#if defined(R2_PASS_DOWNSAMPLE)
Texture2D<float>            g_srcRawDepth           : register( t0 );
RWTexture2D<float>          g_outHalfDepth          : register( u0 );
[numthreads(8, 8, 1)]
void CSDownsample( uint2 id : SV_DispatchThreadID )
{
    int2 vpMax = int2( g_GTAOConsts.ViewportSize ) - 1;
    int2 p = int2( id ) * 2;
    float d[4];
    [unroll] for( int k = 0; k < 4; k++ )
    {
        int2 q = min( p + int2( k & 1, k >> 1 ), vpMax );
        d[k] = g_srcRawDepth.Load( int3( q + int2( g_srcOffset ), 0 ) );
    }
    float z[4]; float mean = 0;
    [unroll] for( int i = 0; i < 4; i++ ) { z[i] = min( XeGTAO_ScreenSpaceToViewSpaceDepth( d[i], g_GTAOConsts ), 65504.0 ); mean += z[i] * 0.25; }
    float best = d[0]; float bestErr = abs( z[0] - mean );
    [unroll] for( int j = 1; j < 4; j++ ) { float e = abs( z[j] - mean ); if( e < bestErr ) { bestErr = e; best = d[j]; } }
    bool planar = abs( z[0] + z[3] - z[1] - z[2] ) < 0.01 * mean + 1e-3 && (max(max(z[0],z[1]),max(z[2],z[3])) - min(min(z[0],z[1]),min(z[2],z[3]))) < 0.1 * mean;
    if( planar )
        best = g_GTAOConsts.DepthUnpackConsts.y - g_GTAOConsts.DepthUnpackConsts.x / mean;    // inverse of XeGTAO_ScreenSpaceToViewSpaceDepth
    g_outHalfDepth[ id ] = best;
}
