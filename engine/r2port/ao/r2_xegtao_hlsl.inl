#if defined(R2_PASS_UPSAMPLE)
Texture2D<float>            g_srcHalfAO             : register( t0 );
Texture2D<float>            g_srcHalfDepth          : register( t1 );
Texture2D<float>            g_srcFullDepth          : register( t2 );
RWTexture2D<unorm float>    g_outFullAO             : register( u0 );
float R2_FullZ( int2 p )
{
    int2 q = clamp( p, int2(0,0), int2( g_GTAOConsts.ViewportSize ) - 1 );
    return min( XeGTAO_ScreenSpaceToViewSpaceDepth( g_srcFullDepth.Load( int3( q + int2( g_srcOffset ), 0 ) ), g_GTAOConsts ), 65504.0 );   // clamp: depth 1.0 (sky) is +inf
}
[numthreads(8, 8, 1)]
void CSUpsample( uint2 id : SV_DispatchThreadID )
{
    uint2 hdim; g_srcHalfAO.GetDimensions( hdim.x, hdim.y );
    int2 ib = int2( id );
    float zc = R2_FullZ( ib );
    float zL = R2_FullZ( ib + int2(-1,0) ), zR = R2_FullZ( ib + int2(1,0) ), zT = R2_FullZ( ib + int2(0,-1) ), zB = R2_FullZ( ib + int2(0,1) );
    float slope = max( min( abs(zL - zc), abs(zR - zc) ), min( abs(zT - zc), abs(zB - zc) ) );
    float tol = 0.01 * zc + 2.5 * slope + 1e-3;
    float2 hp = ((float2)id + 0.5) * 0.5 - 0.5;
    int2 base = (int2)floor( hp );
    float2 f = hp - (float2)base;
    float sum = 0, wsum = 0;
    [unroll] for( int k = 0; k < 4; k++ )
    {
        int2 o = int2( k & 1, k >> 1 );
        int2 q = clamp( base + o, int2(0,0), (int2)hdim - 1 );
        float bw = ((o.x == 0) ? (1 - f.x) : f.x) * ((o.y == 0) ? (1 - f.y) : f.y);
        float zq = min( XeGTAO_ScreenSpaceToViewSpaceDepth( g_srcHalfDepth.Load( int3(q, 0) ), g_GTAOConsts ), 65504.0 );
        float rel = abs( zq - zc ) / tol;
        float w = bw * exp2( -rel * rel ) + 1e-5;
        float ao = g_srcHalfAO.Load( int3(q, 0) );
        sum += w * ao; wsum += w;
    }
    g_outFullAO[ id ] = saturate( sum / wsum );
}
